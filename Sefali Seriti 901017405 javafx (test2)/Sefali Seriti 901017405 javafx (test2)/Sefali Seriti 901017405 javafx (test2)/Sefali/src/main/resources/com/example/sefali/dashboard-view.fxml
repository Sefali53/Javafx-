<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.sefali.DashboardController"
            prefWidth="600"
            prefHeight="400"
            style="-fx-background-color: linear-gradient(to bottom right, #00c6ff, #0072ff);">

    <VBox spacing="24.0"
          alignment="CENTER"
          layoutX="70"
          layoutY="40"
          prefWidth="460"
          prefHeight="320"
          style="-fx-background-color: rgba(255,255,255,0.93);
                 -fx-background-radius: 24;
                 -fx-padding: 36 0 36 0;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.14), 18, 0, 0, 6);">

        <!-- Title Label -->
        <Label text="Dashboard" alignment="CENTER">
            <font>
                <Font name="Segoe UI Semibold" size="30"/>
            </font>
            <style>
                -fx-text-fill: linear-gradient(to right, #00c6ff, #0072ff);
                -fx-font-weight: bold;
                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 3, 0, 0, 1);
            </style>
        </Label>

        <!-- Employee Management Button -->
        <Button text="Employee Management"
                prefWidth="230"
                prefHeight="44"
                onAction="#handleEmployeeManagement"
                style="-fx-background-radius: 22;
                       -fx-background-color: linear-gradient(to right, #f7971e, #ffd200);
                       -fx-text-fill: #333;
                       -fx-font-size: 17px;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;">
            <effect>
                <DropShadow color="#b3000000" radius="7" spread="0.22" />
            </effect>
        </Button>

        <!-- Generate Payroll Report Button -->
        <Button text="Generate Payroll Report"
                prefWidth="230"
                prefHeight="44"
                onAction="#handlePayrollReport"
                style="-fx-background-radius: 22;
                       -fx-background-color: linear-gradient(to right, #43e97b, #38f9d7);
                       -fx-text-fill: #333;
                       -fx-font-size: 17px;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;">
            <effect>
                <DropShadow color="#b3000000" radius="7" spread="0.22" />
            </effect>
        </Button>
        <!-- Add this button to dashboard-view.fxml, inside the VBox -->
        <Button text="Generate Salary"
                prefWidth="230"
                prefHeight="44"
                onAction="#handleSalaryGeneration"
                style="-fx-background-radius: 22;
               -fx-background-color: linear-gradient(to right, #8E2DE2, #4A00E0);
               -fx-text-fill: white;
               -fx-font-size: 17px;
               -fx-font-weight: bold;
               -fx-cursor: hand;">
            <effect>
                <DropShadow color="#b3000000" radius="7" spread="0.22" />
            </effect>
        </Button>
        <!-- Logout Button -->
        <Button text="Logout"
                prefWidth="230"
                prefHeight="44"
                onAction="#handleLogout"
                style="-fx-background-radius: 22;
                       -fx-background-color: linear-gradient(to right, #fc5c7d, #6a82fb);
                       -fx-text-fill: white;
                       -fx-font-size: 17px;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;">
            <effect>
                <DropShadow color="#b3000000" radius="7" spread="0.22" />
            </effect>
        </Button>
    </VBox>
</AnchorPane>