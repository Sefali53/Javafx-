<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.sefali.EmployeeManagementController"
            style="-fx-background-color: linear-gradient(to bottom right, #74ebd5, #ACB6E5);">

    <!-- Top Title with Back Button -->
    <top>
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 15;">
            <Button text="← Back" onAction="#handleBackToDashboard"
                    style="-fx-background-radius: 15; -fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 5 15 5 15;"
                    HBox.hgrow="NEVER">
                <effect>
                    <DropShadow color="#33000000" radius="4" spread="0.3"/>
                </effect>
            </Button>

            <Label text="Employee Management"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                   HBox.hgrow="ALWAYS" alignment="CENTER">
                <effect>
                    <DropShadow color="#33000000" radius="4" spread="0.3"/>
                </effect>
                <font>
                    <Font name="Segoe UI Semibold" size="28"/>
                </font>
            </Label>
        </HBox>
    </top>

    <!-- Center Content -->
    <center>
        <VBox spacing="15.0" alignment="TOP_CENTER" style="-fx-background-color: rgba(255, 255, 255, 0.85); -fx-background-radius: 20;">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Employee Table -->
            <TableView fx:id="employeeTable" prefHeight="260" prefWidth="800" style="-fx-background-radius: 15; -fx-border-radius: 15;">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colFirstName" text="First Name" prefWidth="100"/>
                    <TableColumn fx:id="colLastName" text="Last Name" prefWidth="100"/>
                    <TableColumn fx:id="colPosition" text="Position" prefWidth="100"/>
                    <TableColumn fx:id="colDepartment" text="Department" prefWidth="100"/>
                    <TableColumn fx:id="colBasicSalary" text="Basic Salary" prefWidth="90"/>
                    <TableColumn fx:id="colWorkingHours" text="Working Hours" prefWidth="90"/>
                    <TableColumn fx:id="colRole" text="Role" prefWidth="80"/>
                </columns>
            </TableView>

            <!-- Input Fields -->
            <GridPane hgap="12" vgap="12" alignment="CENTER">
                <columnConstraints>
                    <ColumnConstraints prefWidth="120"/>
                    <ColumnConstraints prefWidth="120"/>
                    <ColumnConstraints prefWidth="120"/>
                    <ColumnConstraints prefWidth="120"/>
                    <ColumnConstraints prefWidth="120"/>
                    <ColumnConstraints prefWidth="120"/>
                </columnConstraints>

                <children>
                    <TextField fx:id="firstNameField" promptText="First Name" prefHeight="35" GridPane.columnIndex="0"
                               style="-fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #3498db; -fx-border-width: 2; -fx-font-size: 14px; -fx-padding: 0 12 0 12;"/>
                    <TextField fx:id="lastNameField" promptText="Last Name" prefHeight="35" GridPane.columnIndex="1"
                               style="-fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #3498db; -fx-border-width: 2; -fx-font-size: 14px; -fx-padding: 0 12 0 12;"/>
                    <TextField fx:id="positionField" promptText="Position" prefHeight="35" GridPane.columnIndex="2"
                               style="-fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #3498db; -fx-border-width: 2; -fx-font-size: 14px; -fx-padding: 0 12 0 12;"/>
                    <TextField fx:id="departmentField" promptText="Department" prefHeight="35" GridPane.columnIndex="3"
                               style="-fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #3498db; -fx-border-width: 2; -fx-font-size: 14px; -fx-padding: 0 12 0 12;"/>
                    <TextField fx:id="salaryField" promptText="Basic Salary" prefHeight="35" GridPane.columnIndex="4"
                               style="-fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #3498db; -fx-border-width: 2; -fx-font-size: 14px; -fx-padding: 0 12 0 12;"/>
                    <ComboBox fx:id="roleComboBox" promptText="Role" prefHeight="35" GridPane.columnIndex="5"
                              style="-fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #3498db; -fx-border-width: 2; -fx-font-size: 14px; -fx-padding: 0 12 0 12;"/>

                    <TextField fx:id="hoursField" promptText="Working Hours" prefHeight="35" GridPane.columnIndex="0" GridPane.rowIndex="1"
                               style="-fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #3498db; -fx-border-width: 2; -fx-font-size: 14px; -fx-padding: 0 12 0 12;"/>
                    <TextField fx:id="overtimeField" promptText="Overtime Hours" prefHeight="35" GridPane.columnIndex="1" GridPane.rowIndex="1"
                               style="-fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #3498db; -fx-border-width: 2; -fx-font-size: 14px; -fx-padding: 0 12 0 12;"/>
                </children>
            </GridPane>

            <!-- Action Buttons -->
            <HBox spacing="20" alignment="CENTER">
                <Button text="Add" onAction="#handleAdd" prefWidth="120" prefHeight="40"
                        style="-fx-background-radius: 20; -fx-background-color: linear-gradient(to right, #56ab2f, #a8e063); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand;">
                    <effect>
                        <DropShadow color="#33000000" radius="6" spread="0.3"/>
                    </effect>
                </Button>
                <Button text="Update" onAction="#handleUpdate" prefWidth="120" prefHeight="40"
                        style="-fx-background-radius: 20; -fx-background-color: linear-gradient(to right, #2980b9, #6dd5fa); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand;">
                    <effect>
                        <DropShadow color="#33000000" radius="6" spread="0.3"/>
                    </effect>
                </Button>
                <Button text="Delete" onAction="#handleDelete" prefWidth="120" prefHeight="40"
                        style="-fx-background-radius: 20; -fx-background-color: linear-gradient(to right, #e52d27, #b31217); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand;">
                    <effect>
                        <DropShadow color="#33000000" radius="6" spread="0.3"/>
                    </effect>
                </Button>
            </HBox>
        </VBox>
    </center>
</BorderPane>