<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.sefali.LoginController" prefWidth="400" prefHeight="300"
            style="-fx-background-color: linear-gradient(to bottom right, #11998e, #38ef7d);">
    <children>
        <!-- Title Label -->
        <Label text="Login" layoutX="160" layoutY="20" prefWidth="80" alignment="CENTER">
            <font>
                <Font name="Segoe UI Semibold" size="28"/>
            </font>
            <style>
                -fx-text-fill: white;
                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 4,0,0,2);
            </style>
        </Label>

        <!-- Username Label -->
        <Label text="Username:" layoutX="50" layoutY="80" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>

        <!-- Username TextField -->
        <TextField fx:id="usernameField" layoutX="150" layoutY="75" prefWidth="200" prefHeight="30"
                   style="-fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: white; -fx-border-width: 2; -fx-font-size: 14px; -fx-padding: 0 10 0 10;"/>

        <!-- Password Label -->
        <Label text="Password:" layoutX="50" layoutY="130" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>

        <!-- Password Field -->
        <PasswordField fx:id="passwordField" layoutX="150" layoutY="125" prefWidth="200" prefHeight="30"
                       style="-fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: white; -fx-border-width: 2; -fx-font-size: 14px; -fx-padding: 0 10 0 10;"/>

        <!-- Login Button -->
        <Button text="Login" layoutX="150" layoutY="180" prefWidth="200" prefHeight="40" onAction="#handleLogin"
                style="-fx-background-radius: 25;
                       -fx-background-color: linear-gradient(to right, #ff416c, #ff4b2b);
                       -fx-text-fill: white;
                       -fx-font-size: 18px;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;">
            <effect>
                <DropShadow color="#b3000000" radius="10" spread="0.3" />
            </effect>
        </Button>

        <!-- Message Label -->
        <Label fx:id="messageLabel" layoutX="150" layoutY="230" prefWidth="200" alignment="CENTER"
               style="-fx-text-fill: #ffdddd; -fx-font-weight: bold; -fx-font-size: 14px;"/>
    </children>
</AnchorPane>
